# Option 1: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini API Key (Uses Gemini via OpenAI SDK!)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_MODEL=gemini-2.5-flash

# Optional custom base URL (default for Gemini is https://generativelanguage.googleapis.com/v1beta/openai/)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Weather API: Open-Meteo is completely free and requires NO API KEY!
